DISCORD_TOKEN=your_bot_token_here

# Supabase project credentials (REST + PostgREST).
# Dashboard -> Project Settings -> API
#   Project URL:  https://<project-ref>.supabase.co
#   service_role key. This bot is a trusted server-side process and its tables
#   and RPC functions are intentionally not exposed to anon/authenticated roles.
SUPABASE_URL=https://your_project_ref.supabase.co
SUPABASE_KEY=your_supabase_service_role_key

# Optional: direct PostgreSQL connection string (not used by the REST path).
# DATABASE_URL=postgresql+asyncpg://postgres:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# Optional: FACEIT integration key. Leave blank or omit if not using FACEIT stats.
FACEIT_API_KEY=

# Environment: development | production
ENVIRONMENT=production

# Log level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
