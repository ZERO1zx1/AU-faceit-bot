DISCORD_TOKEN=your_bot_token_here

# Supabase project credentials (REST + PostgREST).
# Dashboard -> Project Settings -> API
#   Project URL:  https://<project-ref>.supabase.co
#   anon / service_role key (prefer anon, or service_role if the bot needs to
#   bypass Row Level Security).
SUPABASE_URL=https://your_project_ref.supabase.co
SUPABASE_KEY=your_supabase_anon_or_service_role_key

# Optional: direct PostgreSQL connection string (not used by the REST path).
# DATABASE_URL=postgresql+asyncpg://postgres:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

FACEIT_API_KEY=optional_faceit_api_key
ENVIRONMENT=production
LOG_LEVEL=INFO
